# Browser Configuration
BROWSER=chrome
HEADLESS=false
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20
PAGE_LOAD_TIMEOUT=30
WINDOW_SIZE=1920,1080

# Autosys Portal Configuration
AUTOSYS_URL=https://autosys-portal.example.com
AUTOSYS_USERNAME=test_user
AUTOSYS_PASSWORD=test_password

# Database Configuration (SQL Server)
DB_SERVER=localhost
DB_NAME=autosys_db
DB_USERNAME=db_user
DB_PASSWORD=db_password
DB_DRIVER=ODBC Driver 17 for SQL Server

# Test Execution Configuration
MAX_RETRIES=3
RETRY_DELAY=2
LOG_LEVEL=INFO
